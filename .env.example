# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mental_health_chatbot

# ============================================================
# JWT CONFIGURATION (Authentication)
# ============================================================
JWT_SECRET=mental_health_chatbot_super_secret_key_2024_change_this_in_production
JWT_REFRESH_SECRET=mental_health_refresh_token_secret_2024_change_this_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFERRAL_EXPIRY=7d

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=5000
NODE_ENV=development
SERVER_HOST=localhost

# ============================================================
# FRONTEND CONFIGURATION (for CORS & Redirects)
# ============================================================
FRONTEND_URL=http://localhost:3000
FRONTEND_HOST=localhost
FRONTEND_PORT=3000

# ============================================================
# EMAIL CONFIGURATION (Gmail or SendGrid)
# ============================================================
# Choose EMAIL_SERVICE: gmail or sendgrid
EMAIL_SERVICE=gmail

# --- GMAIL CONFIGURATION ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM_NAME=Mental Health Chatbot
EMAIL_FROM_ADDRESS=noreply@mentalhealth.com

# --- SENDGRID CONFIGURATION (Alternative) ---
SENDGRID_API_KEY=your_sendgrid_api_key

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================================
# GEMINI AI CONFIGURATION (Mental Health Chatbot AI)
# ============================================================
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# ============================================================
# OPTIONAL: NLP SERVICE (for sentiment analysis)
# ============================================================
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TIMEOUT=5000

# ============================================================
# OPTIONAL: REDIS CONFIGURATION (for caching/sessions)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================
# BACKUP & MONITORING (Optional)
# ============================================================
ENABLE_REQUEST_LOGGING=true
ENABLE_DB_LOGGING=true
ENABLE_EMAIL_LOGGING=true
